{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [{ "path": "/api/cron", "schedule": "0 0 * * *" }],
  "build": { "env": { "UV_PYTHON": "3.14" } },
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,deploy/**,.github/**,.venv/**,*.md}"
    }
  }
}
